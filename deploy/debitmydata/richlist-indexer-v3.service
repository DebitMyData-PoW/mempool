[Unit]
Description=DebitMyData rich list indexer
After=network.target
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/root/mempool-v3/richlist
ExecStart=/usr/bin/node /root/mempool-v3/richlist/richlist-indexer.js
Restart=always
RestartSec=5
User=root
# The node RPC settings are read from /root/mempool-v3/backend/mempool-config.json (CORE_RPC).
# Optional: Environment=RICHLIST_PORT=8081 RICHLIST_BIND=127.0.0.1 RICHLIST_DB=/root/mempool-v3/richlist/richlist.db
StandardOutput=append:/var/log/richlist-indexer.log
StandardError=append:/var/log/richlist-indexer-error.log

[Install]
WantedBy=multi-user.target
